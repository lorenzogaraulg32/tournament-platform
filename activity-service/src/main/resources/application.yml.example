server:
  port: 8087

spring:
  application:
    name: activity-service

  mongodb:
    uri: mongodb://localhost:27017/activity_db

  security:
    oauth2:
      resourceserver:
        jwt:
          jwk-set-uri: http://localhost:8082/.well-known/jwks.json

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
    register-with-eureka: true
    fetch-registry: true

  instance:
    prefer-ip-address: true
    instance-id: ${spring.application.name}:${server.port}

management:
  endpoints:
    web:
      exposure:
        include: health,info

internal:
  activity-service:
    token: "IL_TUO_TOKEN"